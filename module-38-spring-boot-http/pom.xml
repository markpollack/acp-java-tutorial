<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentclientprotocol</groupId>
        <artifactId>acp-java-tutorial</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>module-38-spring-boot-http</artifactId>
    <name>Module 38 - Spring Boot over HTTP</name>
    <description>A Spring Boot @AcpAgent served over Streamable HTTP with acp-autoconfig, and a Spring Boot client with an AcpClientCustomizer</description>

    <properties>
        <!-- The demo; override with -Dexec.mainClass=... to run one side on its own -->
        <exec.mainClass>com.acptutorial.module38.SpringBootHttpDemo</exec.mainClass>
        <java.version>21</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>acp-spring-boot-starter</artifactId>
        </dependency>
        <!-- spring.acp.agent.transport.type=http needs the SDK's Jetty listener and servlet.
             The starter does not bring it. -->
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-streamable-http-jetty</artifactId>
        </dependency>
        <!-- Exclude parent's slf4j-simple: Spring Boot uses Logback -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Run the demo with: ./mvnw exec:java -pl module-38-spring-boot-http
                 It starts the agent application on a free port, then runs the client application
                 against it twice (with and without the file capability). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
