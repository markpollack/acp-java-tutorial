<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentclientprotocol</groupId>
        <artifactId>acp-java-tutorial</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>module-40-micronaut</artifactId>
    <name>Module 40 - Micronaut</name>
    <description>An annotated ACP agent as a Micronaut bean (acp-micronaut), served over stdio and over HTTP/WebSocket, with Micronaut ACP clients</description>

    <properties>
        <!-- Micronaut core, for the annotation processor: the version acp-micronaut is built on -->
        <micronaut.version>4.10.30</micronaut.version>
    </properties>

    <dependencies>
        <!-- The Micronaut integration: brings acp-agent-support (and with it acp-core, the
             annotations and Jackson 2) and micronaut-context. -->
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-micronaut</artifactId>
        </dependency>
        <!-- Only for acp.agent.transport.type=http: the SDK's Streamable HTTP and WebSocket
             listener, which runs on its own port next to (not inside) any Micronaut server. -->
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-streamable-http-jetty</artifactId>
        </dependency>
        <!-- slf4j-simple (from the parent) logs to standard error, as a stdio agent requires;
             simplelogger.properties sets the level. -->
    </dependencies>

    <build>
        <plugins>
            <!-- Micronaut's annotation processor writes the bean definitions (the agent, the
                 interceptor, the client customizer) at compile time: no classpath scan at run time. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.micronaut</groupId>
                            <artifactId>micronaut-inject-java</artifactId>
                            <version>${micronaut.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.acptutorial.module40.MicronautDemo</mainClass>
                </configuration>
            </plugin>
            <!-- The agent application as one JAR (java -jar target/micronaut-agent.jar), which the
                 demo's stdio client launches. The services transformer merges Micronaut's
                 META-INF/services entries. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.acptutorial.module40.Application</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <finalName>micronaut-agent</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
